# ===================================================================
# IntentLock Commerce Security Engine - Environment Configuration
# ===================================================================
# Copy this file to '.env' (which is gitignored) for local development
# or set these variables directly in your host / CI / Docker environment.
#
# DO NOT COMMIT YOUR ACTUAL '.env' OR ANY PRIVATE KEY TO GIT!
# ===================================================================

# 1. Ed25519 Persistent Private Key (64-character hex string)
# Corresponds to trusted public key: 4df93f582d2b31f519c1982bb55c1aa46b4d64498fa04164eeb36c44c0f1cca9
# Obtain securely out-of-band from the team key manager (via 1Password / Vault).
INTENTLOCK_PRIVATE_KEY_HEX=

# 2. Alternative: Local filesystem path to the private key hex file
# (Default: keys/intentlock_private_key.hex)
# INTENTLOCK_PRIVATE_KEY_PATH=keys/intentlock_private_key.hex

# 3. Path to the trusted public key hex file
# (Default: keys/intentlock_public_key.hex)
# INTENTLOCK_PUBLIC_KEY_PATH=keys/intentlock_public_key.hex

# 4. Enforce persistent key validation at startup
# When true, the server fails immediately if the persistent key is missing
# rather than falling back to an ephemeral keypair.
INTENTLOCK_REQUIRE_PERSISTENT_KEY=false

# 5. SQLite Audit Database Path
INTENTLOCK_DB_PATH=intentlock_audit.db

