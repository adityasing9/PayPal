# ==============================================================================
# IntentLock Commerce — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate placeholders with environment-specific values.
# 3. NEVER commit the actual .env file or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration (MANDATORY)
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server port
PORT=5000

# Client Application URL (used for CORS whitelist and cookie origins)
APP_ORIGIN=http://localhost:3000

# Canonical API Base URL
API_BASE_URL=http://localhost:5000/api

# Reverse proxy trust configuration:
# - Development default: 0 (disabled; reads direct socket address to prevent X-Forwarded-For spoofing)
# - Production: set to exact number of trusted proxy hops (e.g., 1 for single ALB/Nginx) or trusted CIDRs
TRUST_PROXY_HOPS=0


# ------------------------------------------------------------------------------
# 2. Database Configuration (MANDATORY)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas URI)
# Invariant: No silent fallback is permitted; connection fails if unreachable.
MONGODB_URI=mongodb://127.0.0.1:27017/intentlock

# Target database name
MONGODB_DB_NAME=intentlock


# ------------------------------------------------------------------------------
# 3. Authentication & Cryptographic Security (MANDATORY)
# ------------------------------------------------------------------------------
# Secret key used to sign session JWTs (Minimum 32 random characters)
SESSION_SECRET=your-secure-session-secret-at-least-32-chars-long

# Secret key used for HMAC-SHA256 session-bound CSRF token generation
CSRF_SECRET=your-secure-csrf-secret-at-least-32-chars-long

# Ed25519 Signing Vault (Hex-encoded keys for IntentLock Firewall)
# In development, mock keys may be used when USE_MOCK_SECURITY=true.
# In production, production keys are mandatory and mock keys are rejected.
ED25519_KEY_ID=KEY_MOCK_ED25519_2026_V1
ED25519_PUBLIC_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0
ED25519_PRIVATE_KEY=f0e1d2c3b4a5968778695a4b3c2d1e0f0123456789abcdef0123456789abcdefa1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# Adapter Modes: Set to 'true' to use local deterministic mock adapters.
# INVARIANT: Production (NODE_ENV=production) will fail closed if set to true.
USE_MOCK_SECURITY=true
USE_MOCK_PAYPAL=true


# ------------------------------------------------------------------------------
# 4. PayPal Sandbox Configuration (OPTIONAL FOR BASELINE / REQUIRED FOR LIVE API)
# ------------------------------------------------------------------------------
# PayPal environment: 'sandbox' or 'live'
PAYPAL_ENVIRONMENT=sandbox

# PayPal REST Application Credentials (from PayPal Developer Dashboard)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-placeholder
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-placeholder

# PayPal Registered Webhook ID (used for signature verification)
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-placeholder


# ------------------------------------------------------------------------------
# 5. AI Commerce Agent Configuration (OPTIONAL FOR BASELINE / REQUIRED FOR LIVE AI)
# ------------------------------------------------------------------------------
# AI Provider: 'offline_fixture' (default), 'gemini', 'openai', or 'anthropic'
AI_PROVIDER=offline_fixture

# AI Provider API Key (not required when AI_PROVIDER=offline_fixture)
AI_API_KEY=your-ai-provider-api-key-placeholder

# AI Model Name
AI_MODEL=gemini-1.5-pro


# ------------------------------------------------------------------------------
# 6. Operational & Security Thresholds (MANDATORY WITH DEFAULTS)
# ------------------------------------------------------------------------------
# Logging level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# High-value audit anchoring threshold in integer minor units (20000 = $200.00 USD)
HIGH_VALUE_ANCHOR_THRESHOLD_MINOR=20000

# Audit log anchoring cron schedule (default: hourly)
AUDIT_ANCHOR_CRON=0 * * * *

# Rate Limiting: General API window and max requests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=60
RATE_LIMIT_MAX_AUTH=10
