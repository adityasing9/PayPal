
{
  "name": "intentlock-commerce",
  "version": "1.0.0",
  "description": "AI Personal Shopping Agent with an Intelligent Payment Security Firewall",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:agent": "node server.js",
    "dev": "nodemon src/server.js",
    "dev:agent": "node --watch server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:agent": "node --test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:frontend": "oxlint",
    "demo": "node demo.js",
    "verify": "node verify.js",
    "check": "node --test && node verify.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityasing9/PayPal.git"
  },
  "keywords": [
    "fintech",
    "ai",
    "paypal",
    "agentic-commerce",
    "ed25519",
    "security-firewall"
  ],
  "author": "IntentLock Commerce Engineering Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "argon2": "0.41.1",
    "axios": "^1.21.0",
    "canonicalize": "2.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "^1.70.0",
    "mongoose": "8.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.14.0",
    "nodemon": "3.1.7",
    "oxlint": "^1.90.0",
    "supertest": "7.0.0",
    "vite": "^8.3.6",
    "vitest": "2.1.4"
  }
